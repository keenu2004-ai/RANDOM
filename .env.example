# THEIAKSHI ENTERPRISE HRMS — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit the .env file to version control.

# ============================================================
# RUNTIME ENVIRONMENT
# ============================================================
# Options: development | production | test
NODE_ENV=development

# Server port
PORT=3000

# ============================================================
# DATABASE CONFIGURATION (REQUIRED IN PRODUCTION)
# ============================================================
# Options: postgres | pglite (pglite is for local dev only)
DATABASE_PROVIDER=pglite

# Required when DATABASE_PROVIDER=postgres
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://your_user:your_password@localhost:5432/theiakshi_hrms

# ============================================================
# SECURITY SECRETS (REQUIRED IN PRODUCTION)
# ============================================================
# JWT_SECRET: minimum 32 randomly generated characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# JWT token expiration (default: 7d)
JWT_EXPIRATION=7d

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed frontend origins
# Example: https://hrms.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# FILE STORAGE CONFIGURATION
# ============================================================
# Maximum document upload size in MB (default: 10)
MAX_DOCUMENT_SIZE_MB=10

# Maximum JSON request body size (default: 1mb)
MAX_JSON_SIZE=1mb

# ============================================================
# REPORT EXPORT LIMITS
# ============================================================
# Maximum rows in CSV export (default: 5000)
MAX_CSV_EXPORT_ROWS=5000

# ============================================================
# PUSH NOTIFICATIONS CONFIGURATION
# ============================================================
# Provider options: log (development only) | expo | fcm | apns
PUSH_PROVIDER=log

# Expo Push Notifications (when PUSH_PROVIDER=expo)
# EXPO_ACCESS_TOKEN=your_expo_access_token_here

# FCM (when PUSH_PROVIDER=fcm)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# APNs (when PUSH_PROVIDER=apns)
# APNS_KEY_ID=your_key_id
# APNS_TEAM_ID=your_team_id
# APNS_BUNDLE_ID=com.theiakshi.enterprise
# APNS_KEY_PATH=/path/to/AuthKey_KEYID.p8

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Log level: error | warn | info | debug (default: info)
LOG_LEVEL=info

# ============================================================
# MOBILE API CONFIGURATION (Set in /mobile/.env)
# ============================================================
# EXPO_PUBLIC_API_URL=https://your-backend.example.com/api
